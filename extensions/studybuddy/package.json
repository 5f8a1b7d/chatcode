{
  "name": "latentnote-study-buddy",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "latentnote",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./out/extension",
  "activationEvents": [
	"onStartupFinished",
    "onCommand:latentnote.studyBuddy.explainSelection",
	"onCommand:latentnote.studyBuddy.handleSystemSelectionAction",
    "onCommand:latentnote.studyBuddy.addToMemory",
    "onCommand:latentnote.studyBuddy.cancelExplain",
    "onCommand:latentnote.studyBuddy.setAccessToken",
    "onCommand:latentnote.manageProviders",
    "onView:latentnote.studyBuddy.explanation"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "chatAgents": [
      {
        "path": "./agents/studybuddy.agent.md"
      }
    ],
    "languageModelTools": [
      {
        "name": "studybuddy_search_notes",
        "toolReferenceName": "studybuddy_search_notes",
        "displayName": "%tool.searchNotes%",
        "modelDescription": "Search Markdown study notes in the current workspace. Returns matching excerpts with file URIs and line numbers. Use to ground explanations in the learner's actual notes; does not search saved memories.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Text or concept to find in Markdown study notes." }
          },
          "required": ["query"]
        }
      },
      {
        "name": "studybuddy_search_memories",
        "toolReferenceName": "studybuddy_search_memories",
        "displayName": "%tool.searchMemories%",
        "modelDescription": "Search the learner's saved Study Buddy explanations in the current project. Returns matching excerpts and source locations, or an empty result. Use before citing previous learning or claiming a concept was remembered.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Concept or phrase to find in saved learning memories." }
          },
          "required": ["query"]
        }
      },
      {
        "name": "studybuddy_save_memory",
        "toolReferenceName": "studybuddy_save_memory",
        "displayName": "%tool.saveMemory%",
        "modelDescription": "Save a user-approved learning note to the current project's Study Buddy memory. Use only when the user asks to remember or save it. Supply the source material and the explanation accurately.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sourceText": { "type": "string", "description": "The original material or user question." },
            "explanation": { "type": "string", "description": "The explanation or learning note to save." }
          },
          "required": ["sourceText", "explanation"]
        }
      },
      {
        "name": "studybuddy_explain_material",
        "toolReferenceName": "studybuddy_explain_material",
        "displayName": "%tool.explainMaterial%",
        "modelDescription": "Ask the Study Buddy learning service to explain or summarize supplied study material. Returns the service's actual explanation; does not edit workspace files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "material": { "type": "string", "description": "The source material to explain." },
            "question": { "type": "string", "description": "What the learner wants explained about the material." }
          },
          "required": ["material", "question"]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "latentnote.studyBuddy.chat",
        "name": "studybuddy",
        "fullName": "%chat.participant.name%",
        "description": "%chat.participant.description%",
        "isSticky": true,
        "commands": [
          { "name": "explain", "description": "%chat.command.explain%" },
          { "name": "translate", "description": "%chat.command.translate%" },
          { "name": "summarize", "description": "%chat.command.summarize%" },
          { "name": "code", "description": "%chat.command.code%" }
        ]
      }
    ],
    "commands": [
      {
        "command": "latentnote.studyBuddy.explainSelection",
        "title": "%command.explain%",
        "shortTitle": "%command.explain.short%",
        "category": "%category%",
        "icon": "$(sparkle)",
        "enablement": "editorLangId == markdown && editorHasSelection"
      },
      {
        "command": "latentnote.studyBuddy.cancelExplain",
        "title": "%command.cancel%",
        "category": "%category%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "latentnote.studyBuddy.addToMemory",
        "title": "%command.addToMemory%",
        "category": "%category%",
        "icon": "$(bookmark)"
      },
      {
        "command": "latentnote.studyBuddy.setAccessToken",
        "title": "%command.setAccessToken%",
        "category": "%category%"
      },
      {
        "command": "latentnote.manageProviders",
        "title": "%command.manageProviders%",
        "category": "%category%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "latentnote.studyBuddy.explainSelection",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "latentnote.studyBuddy.explainSelection",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "navigation@50"
        }
      ],
      "view/title": [
        {
          "command": "latentnote.studyBuddy.cancelExplain",
          "when": "view == latentnote.studyBuddy.explanation && latentnote.studyBuddy.explanationRunning",
          "group": "navigation"
        },
        {
          "command": "latentnote.studyBuddy.addToMemory",
          "when": "view == latentnote.studyBuddy.explanation && latentnote.studyBuddy.explanationCanSave",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "latentnoteStudyBuddy",
          "title": "%viewContainer.title%",
          "icon": "media/study-buddy.svg"
        }
      ]
    },
    "views": {
      "latentnoteStudyBuddy": [
        {
          "type": "webview",
          "id": "latentnote.studyBuddy.explanation",
          "name": "%view.explanation.name%",
          "icon": "$(lightbulb)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "latentnote.studyBuddy.explanation",
        "contents": "%view.explanation.welcome%"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "latentnote-catalog",
        "displayName": "Provider Catalog"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "latentnote.studyBuddy.serviceUrl": {
          "type": "string",
          "default": "http://192.168.0.101:8787",
          "description": "%configuration.serviceUrl.description%"
        },
        "latentnote.studyBuddy.projectId": {
          "type": "string",
          "default": "",
          "description": "%configuration.projectId.description%"
		},
        "latentnote.studyBuddy.globalSelection.enabled": {
		  "type": "boolean",
		  "default": true,
		  "description": "%configuration.globalSelection.enabled.description%"
        },
        "chat.customProviders.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.customProviders.enabled.description%"
        }
      }
    }
  },
  "scripts": {
    "catalog:compile": "node scripts/compile-provider-catalog.cjs",
    "compile": "npm run catalog:compile && gulp compile-extension:studybuddy",
    "catalog:check": "node scripts/compile-provider-catalog.cjs --check",
    "watch": "gulp watch-extension:studybuddy",
    "test": "node --test out/test/*.test.js && npm run catalog:check"
  },
  "devDependencies": {
    "@types/node": "24.x"
  }
}
